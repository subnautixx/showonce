# Which model watches your recording: claude | openai | gemini | ollama | mock | mcp
# mcp = no API key: the AI assistant you connect over MCP writes the plan (see "No API key" in the README)
SHOWONCE_PROVIDER=claude

# Optional: override the model for the chosen provider
# SHOWONCE_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible API works
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

# Your n8n instance (only needed for "Create in n8n"; "Download JSON" works without it)
# Create an API key in n8n: Settings → n8n API
N8N_URL=http://localhost:5678
N8N_API_KEY=

# Server
PORT=8787
# Max screenshots sent to the model per recording
SHOWONCE_MAX_IMAGES=20
