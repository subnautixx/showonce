{
  "manifest_version": 3,
  "name": "ShowOnce",
  "version": "0.1.0",
  "description": "Do a task once in your browser. Get an n8n workflow that does it forever.",
  "permissions": ["storage", "unlimitedStorage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "ShowOnce",
    "default_popup": "popup.html"
  }
}
